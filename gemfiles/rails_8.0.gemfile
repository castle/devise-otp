# Hand-maintained per-Rails-version gemfile (no longer Appraisal-generated).

source "https://rubygems.org"

gem "capybara"
gem "minitest-reporters", ">= 0.5.0"
gem "puma"
gem "rake"
gem "rdoc"
gem "shoulda"
gem "sprockets-rails"
gem "sqlite3", "~> 2.1"
gem "timecop", "~> 0.9.10"
gem "rubocop-rails-omakase", require: false
gem "erb_lint", require: false
gem "debug"
gem "devise", "~> 5.0"
gem "rails", "~> 8.0.0"

gemspec path: "../"
