# Hand-maintained per-Rails-version gemfile (no longer Appraisal-generated).

source "https://rubygems.org"

gem "capybara"
gem "minitest-reporters", ">= 0.5.0"
gem "puma"
gem "rake"
gem "rdoc"
gem "shoulda"
gem "sprockets-rails"
gem "sqlite3", "~> 1.5.0"
gem "timecop", "~> 0.9.10"
gem "rubocop-rails-omakase", require: false
gem "erb_lint", require: false
gem "debug"
gem "devise", "~> 4.9"
gem "rails", "~> 7.1.0"

install_if -> { Gem::Version.new(RUBY_VERSION) >= Gem::Version.new("3.4.0") } do
  gem "logger"
end

gemspec path: "../"
